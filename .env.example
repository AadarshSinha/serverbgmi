# Copy to `.env` for local development. `.env` is gitignored.

# development | production
APP_ENV=development
PORT=4000

# --- database ---------------------------------------------------------------
# Postgres everywhere, so local behaviour matches production. Pick one:
#
# 1. The db container from docker-compose.dev.yml (started by `make dev`).
#    Inside the container the host is `db`; from your shell or the venv it is
#    localhost, because the service publishes 127.0.0.1:5432.
# DATABASE_URL=postgresql://zonepredictor:localdev@localhost:5432/zonepredictor
#
# 2. A free hosted dev database (Neon, Supabase). This is the one to use if you
#    cannot run containers on this machine — real Postgres, no Docker needed.
# DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/zonepredictor
#
# 3. Left unset it falls back to a local SQLite file. Convenient, but it is the
#    one setting where local stops resembling production.
#
# In production this MUST be a managed Postgres (Neon / Supabase / RDS) so the
# data survives the droplet being destroyed. The app refuses to boot with
# APP_ENV=production while this is SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/zonepredictor

# --- auth -------------------------------------------------------------------
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret
JWT_ACCESS_TOKEN_EXPIRES_HOURS=168

# --- cors -------------------------------------------------------------------
# "*" is fine locally; list real origins in production.
ALLOWED_ORIGINS=*
# ALLOWED_ORIGINS=https://zonepredictor.com,https://www.zonepredictor.com

# --- uploads ----------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
# Every uploaded screenshot is kept as future training data. Set to false to
# stop storing them (request counts are still logged).
STORE_UPLOADS=true
# Without S3_BUCKET, screenshots land in LOCAL_UPLOAD_DIR -- which on a server
# means they die with the instance. Set these in production.
#
# Neon Object Storage (S3-compatible, same project as the database, 5GB free):
# S3_BUCKET=zonepredictor-uploads
# S3_ENDPOINT_URL=https://<your-neon-object-storage-endpoint>
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
#
# Cloudflare R2 uses the same four lines with its own endpoint; real AWS S3
# needs only S3_BUCKET plus AWS_REGION and the usual AWS credentials.
S3_PREFIX=uploads
AWS_REGION=ap-south-1
# LOCAL_UPLOAD_DIR=./uploads

# --- billing (Cashfree) -----------------------------------------------------
# Leave false until you are ready to charge. The /billing endpoints exist and
# return 503 while this is off.
BILLING_ENABLED=false
CASHFREE_ENV=sandbox
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_WEBHOOK_SECRET=
# CASHFREE_RETURN_URL=https://zonepredictor.com/billing/return
